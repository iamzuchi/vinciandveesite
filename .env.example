# Resend API Configuration for Vinci & Vee Central Contact Dispatch
# Sign up at https://resend.com to generate your API key
RESEND_API_KEY=re_your_api_key_here

# Central email address that should receive all form inquiries across all sectors
CENTRAL_COMPANY_EMAIL=info@vinciandvee.com

# Verified sender email address configured on Resend (e.g. notifications@vinciandvee.com or onboarding@resend.dev during testing)
SENDER_EMAIL=onboarding@resend.dev
